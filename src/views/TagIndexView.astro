---
import BaseLayout from "../layouts/BaseLayout.astro";
import { tagLabel } from "../consts";
import { localePath, t, type Locale } from "../i18n/ui";
import { getPosts, getTags } from "../lib/posts";

interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const tags = getTags(await getPosts(locale));
---

<BaseLayout
    locale={locale}
    alternates={{ ko: localePath("ko", "/tags"), en: localePath("en", "/tags") }}
    title="Tags"
    description={t(locale, "tagsDescription")}
>
    <h1 class="page-title">Tags</h1>
    <ul class="tag-cloud">
        {
            [...tags].map(([tag, posts]) => (
                <li>
                    <a class="tag" href={localePath(locale, `/tags/${tag}`)}>
                        {tagLabel(tag)} <span class="count">{posts.length}</span>
                    </a>
                </li>
            ))
        }
    </ul>
</BaseLayout>
