---
import { tagLabel } from "../consts";
import { localePath, t, type Locale } from "../i18n/ui";
import { formatDate, postUrl, type Post } from "../lib/posts";

interface Props {
    posts: Post[];
    locale?: Locale;
}
const { posts, locale = "ko" } = Astro.props;
---

<ul class="post-list">
    {
        posts.map((post) => (
            <li class="post-item">
                <h2 class="post-title">
                    {post.data.pinned && <span class="pin-badge">{t(locale, "pinned")}</span>}
                    <a class="post-link" href={postUrl(post)}>
                        {post.data.title}
                    </a>
                </h2>
                {post.data.description && <p class="post-description">{post.data.description}</p>}
                <div class="post-meta">
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
                    {post.data.tags.map((tag) => (
                        <a class="tag" href={localePath(locale, `/tags/${tag}`)}>
                            {tagLabel(tag)}
                        </a>
                    ))}
                </div>
            </li>
        ))
    }
</ul>
