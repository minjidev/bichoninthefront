---
import PostView from "../../views/PostView.astro";
import { getPostsByDate, slugOf } from "../../lib/posts";

export async function getStaticPaths() {
    const posts = await getPostsByDate("en");
    return posts.map((post, i) => ({
        params: { slug: slugOf(post) },
        props: { post, newer: posts[i - 1], older: posts[i + 1] },
    }));
}
---

<PostView {...Astro.props} />
