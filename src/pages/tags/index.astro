---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { tagLabel } from "../../consts";
import { getPosts, getTags } from "../../lib/posts";

const tags = getTags(await getPosts());
---

<BaseLayout title="Tags" description="태그별로 글 모아보기">
    <h1 class="page-title">Tags</h1>
    <ul class="tag-cloud">
        {
            [...tags].map(([tag, posts]) => (
                <li>
                    <a class="tag" href={`/tags/${tag}`}>
                        {tagLabel(tag)} <span class="count">{posts.length}</span>
                    </a>
                </li>
            ))
        }
    </ul>
</BaseLayout>
